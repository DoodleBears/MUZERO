      /* ---------- fullscreen image lightbox ---------- */
      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: clamp(20px, 6vw, 72px);
        /* the surrounding mask: dim + frost so the image pops, and the cursor
           hints that clicking the mask closes. */
        background: color-mix(in srgb, var(--bg) 18%, rgba(0, 0, 0, 0.82));
        backdrop-filter: blur(10px) saturate(1.1);
        -webkit-backdrop-filter: blur(10px) saturate(1.1);
        cursor: zoom-out;
        animation: lightbox-fade 0.2s ease both;
      }
      .lightbox[hidden] {
        display: none;
      }
      @keyframes lightbox-fade {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      .lightbox-stage {
        position: relative;
        overflow: hidden;
        max-width: 100%;
        max-height: 100%;
        /* match the source tile's 16px so the View Transition only scales the
           corner — no radius-value reconciliation mid-morph. */
        border-radius: 16px;
        box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.8);
        /* The rounded frame lives here and is NEVER transformed — only the inner
           <img> scales for zoom, so the corners stay crisp (no shimmer). */
        cursor: zoom-in; /* click to enlarge */
        touch-action: manipulation; /* kill tap delay + native double-tap zoom */
        -webkit-tap-highlight-color: transparent;
      }
      .lightbox-stage.zoomed {
        cursor: zoom-out; /* click to return to fit */
      }
      .lightbox-img {
        display: block;
        width: 100%;
        height: 100%;
        transform-origin: center center;
        will-change: transform;
        user-select: none;
        -webkit-user-drag: none;
        /* the click zoom animates smoothly; wheel-zoom sets duration 0 per frame
           inline for 1:1 response. */
        transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .lightbox-close {
        position: absolute;
        top: clamp(14px, 3vw, 28px);
        right: clamp(14px, 3vw, 28px);
        z-index: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        background: rgba(0, 0, 0, 0.4);
        color: #fff;
        cursor: pointer;
        transition:
          background 0.15s ease,
          transform 0.15s ease;
      }
      .lightbox-close:hover {
        background: rgba(0, 0, 0, 0.62);
        transform: scale(1.06);
