    </style>

    <!-- View Transition pseudo-elements are document-global and cannot be Astro
         scoped, so the lightbox morph timing lives in an is:global block. -->
    <style is:global>
      ::view-transition-group(lightbox-media) {
        animation-duration: 0.42s;
        animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
      }
      ::view-transition-old(lightbox-media),
      ::view-transition-new(lightbox-media) {
        /* same image content on both sides → no cross-fade flicker, just morph. */
        mix-blend-mode: normal;
      }
    </style>

    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      // Floating island header: frost + shrink once the page is scrolled.
      const siteHeader = document.getElementById("siteHeader");
      if (siteHeader) {
        const onHeaderScroll = () =>
          siteHeader.classList.toggle("scrolled", window.scrollY > 16);
        onHeaderScroll();
        window.addEventListener("scroll", onHeaderScroll, { passive: true });
      }

      // Animations run regardless of prefers-reduced-motion (product decision).
      const field = document.getElementById("field");
      const hero = document.querySelector(".hero");
      const finale = document.getElementById("finale");

      if (field && hero) {
        // NO JS entrance fade: the covers are visible by default (CSS). A
        // `gsap.from(opacity:0)` here previously set opacity 0 immediately and
        // relied on rAF to animate back to 1 — if that rAF was throttled or
        // interrupted on load (background tab / restored scroll), the whole field
        // stayed stuck at opacity 0 (covers intermittently invisible).

        // Subtle pointer parallax: drift the whole field (x/y are unshared with
        // the scroll sequence, which animates --gather + opacity).
        const px = gsap.quickTo(field, "x", { duration: 0.8, ease: "power3" });
        const py = gsap.quickTo(field, "y", { duration: 0.8, ease: "power3" });
        window.addEventListener(
          "pointermove",
          (e) => {
            px((e.clientX / window.innerWidth - 0.5) * 26);
            py((e.clientY / window.innerHeight - 0.5) * 18);
          },
          { passive: true },
        );

        // Scroll (desktop): covers converge from every direction to the center
        // (copy stays visible through the gather), then resolve into the logo.
        gsap.matchMedia().add("(min-width: 961px)", () => {
          const conv = gsap.timeline({
            scrollTrigger: {
              trigger: hero,
              start: "top top",
              end: "+=150%",
              scrub: 0.6,
              pin: true,
              anticipatePin: 1,
            },
          });
          conv.fromTo(
            field,
            { "--gather": 0 },
            { "--gather": 1, ease: "power2.inOut", duration: 0.85 },
            0,
          );
          // The TITLE stays visible the whole time — only the supporting copy
          // (eyebrow, lede, initial CTA) fades as the covers gather.
          conv.to(
            ".fade-out",
            { autoAlpha: 0, y: -16, ease: "power1.in", duration: 0.3, stagger: 0.03 },
            0.45,
          );
          // Covers fade as they pile into the convergence spot below the title.
          // NB: fade .cover-field (inner), NOT .hero-visual — the entrance tween
          // owns .hero-visual's opacity, and sharing it caused an intermittent
          // race where ScrollTrigger.refresh() left the whole field hidden.
          conv.to(
            ".cover-field",
            { autoAlpha: 0, ease: "power1.in", duration: 0.22 },
            0.78,
          );
          if (finale) {
            // The logo (formed by the gather) + a CTA row re-appear below the
            // title — the convergence climax.
            conv.fromTo(
              finale,
              { autoAlpha: 0, y: 26, scale: 0.92 },
              {
                autoAlpha: 1,
                y: 0,
                scale: 1,
                ease: "back.out(1.4)",
                duration: 0.4,
                immediateRender: false,
              },
              0.72,
            );
          }
        });
      }

      // --- Scroll-reveal for the image showcase + download ---
      gsap.utils.toArray(".reveal").forEach((el) => {
        gsap.from(el, {
          opacity: 0,
          y: 48,
          duration: 0.8,
          ease: "power2.out",
          scrollTrigger: {
            trigger: el,
            start: "top 84%",
            toggleActions: "play none none reverse",
          },
        });
      });

      window.addEventListener("load", () => ScrollTrigger.refresh());
    </script>

    <script>
      // Populate the download tiles from the live release manifest (same source
      // as the desktop app's Settings → Version history). Shows the latest
      // version on each button; falls back gracefully if nothing is published.
      import { fetchManifest, currentOsFamily, VARIANT_LABEL, osAssets } from "../lib/release";

      const sub = document.getElementById("dl-sub");
      const tilesWrap = document.getElementById("dl-tiles");
      const fallback = document.getElementById("dl-fallback");
      const allLink = document.getElementById("dl-all");

      async function initDownloads() {
        if (!tilesWrap) return;
        try {
          const manifest = await fetchManifest();
          const latest =
            manifest.releases.find((r) => r.version === manifest.latest) ?? manifest.releases[0];
          if (!latest) throw new Error("no releases");

          if (sub) sub.innerHTML = `Latest <strong>v${latest.version}</strong> · ${latest.date}`;
          if (allLink) allLink.hidden = false;

          const os = currentOsFamily();
          for (const tile of Array.from(tilesWrap.querySelectorAll(".dl-tile"))) {
            const tileOs = tile.getAttribute("data-os") as "mac" | "win" | "linux";
            const assets = osAssets(latest, tileOs);
            const btn = tile.querySelector<HTMLAnchorElement>("[data-dl-primary]");
            const variants = tile.querySelector<HTMLElement>("[data-dl-variants]");
            const unavail = tile.querySelector<HTMLElement>("[data-dl-unavail]");
            if (!btn || !variants) continue;
            if (assets.length === 0) {
              if (unavail) unavail.hidden = false;
              continue;
            }
            btn.href = latest.platforms[assets[0]]!.url;
            btn.textContent = `Download · v${latest.version}`;
            btn.hidden = false;
            variants.innerHTML = assets
              .slice(1)
              .map((p) => `<a href="${latest.platforms[p]!.url}">${VARIANT_LABEL[p]}</a>`)
              .join(" · ");
            if (tileOs === os) tile.classList.add("dl-tile--match");
          }
          if (os !== "other") {
            const match = tilesWrap.querySelector(`.dl-tile[data-os="${os}"]`);
            if (match) tilesWrap.prepend(match);
          }
        } catch {
          tilesWrap.hidden = true;
          if (sub) sub.hidden = true;
          if (fallback) fallback.hidden = false;
        }
      }

      void initDownloads();
    </script>

    <script>
      // Fullscreen image lightbox with a native View Transition open/close
      // (the showcase tile morphs into the fitted image and back). Click toggles
      // zoom (in toward the click point / back to fit); scroll fine-tunes. No deps.
      const lightbox = document.getElementById("lightbox") as HTMLElement | null;
      const lightboxImg = document.getElementById("lightboxImg") as HTMLImageElement | null;
      const lightboxStage = document.getElementById("lightboxStage") as HTMLElement | null;
      const lightboxClose = document.getElementById("lightboxClose");
      const VT_NAME = "lightbox-media";
      const MIN_SCALE = 1;
      const MAX_SCALE = 6;
      const ZOOM_LEVEL = 2.5;

      if (lightbox && lightboxImg && lightboxStage) {
        const img = lightboxImg; // narrowed, non-null
        const stage = lightboxStage; // narrowed, non-null
        const overlay = lightbox; // narrowed, non-null
        let scale = 1;
        let tx = 0;
        let ty = 0;
        // The source tile (the .show-media <button>) is the View Transition
        // counterpart — naming the rounded, self-clipping box (not the inner
        // <img>) avoids the snapshot escaping its ancestor's overflow clip and
        // snapping at the end of the morph.
        let lastSource: HTMLElement | null = null;

        const clamp = (v: number, lo: number, hi: number) =>
          Math.min(hi, Math.max(lo, v));
        // `apply(animate)` writes the transform; pass animate=true for the click
        // toggle (smooth) and false for wheel/reset (instant, 1:1). The `.zoomed`
        // class flips the stage cursor (zoom-in ↔ zoom-out).
        const apply = (animate = false) => {
          img.style.transitionDuration = animate ? "" : "0s";
          img.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
          stage.classList.toggle("zoomed", scale > MIN_SCALE + 0.001);
        };
        const reset = () => {
          scale = 1;
          tx = 0;
          ty = 0;
          apply(false);
        };

        // Zoom toward a viewport point (anchored), to `targetScale`.
        const zoomTo = (
          targetScale: number,
          clientX: number,
          clientY: number,
          animate: boolean,
        ) => {
          const next = clamp(targetScale, MIN_SCALE, MAX_SCALE);
          const rect = img.getBoundingClientRect();
          const dx = clientX - (rect.left + rect.width / 2);
          const dy = clientY - (rect.top + rect.height / 2);
          tx += (dx / scale) * (scale - next);
          ty += (dy / scale) * (scale - next);
          scale = next;
          if (scale <= MIN_SCALE) {
            tx = 0;
            ty = 0;
          }
          apply(animate);
        };

        // --- open / close (with View Transition morph when supported) ---
        const startVT = (window.document as any).startViewTransition?.bind(document);

        // Size the image to fill the viewport (contain-fit, upscaling allowed) so
        // it reads as a true fullscreen view instead of its small native size.
        // Sizing the element itself (vs object-fit) keeps the box hugging the
        // image, so clicks on the surrounding mask still close. Zoom/pan ride on
        // top via transform.
        const sizeToViewport = (nw: number, nh: number) => {
          if (!nw || !nh) return;
          const padX = parseFloat(getComputedStyle(overlay).paddingLeft) || 0;
          const padY = parseFloat(getComputedStyle(overlay).paddingTop) || 0;
          const availW = Math.max(1, overlay.clientWidth - padX * 2);
          const availH = Math.max(1, overlay.clientHeight - padY * 2);
          const ratio = nw / nh;
          let w = availW;
          let h = w / ratio;
          if (h > availH) {
            h = availH;
            w = h * ratio;
          }
          stage.style.width = `${Math.round(w)}px`;
          stage.style.height = `${Math.round(h)}px`;
        };

        // Fit using the best natural size available: the big image once decoded,
        // else the (usually already-loaded) source thumbnail. If neither is known
        // yet, clear the inline size so the CSS max-width fallback shows it; the
        // big image's load event (below) then re-fits.
        const applyFit = () => {
          const thumb = lastSource ? lastSource.querySelector("img") : null;
          const nw = img.naturalWidth || (thumb ? thumb.naturalWidth : 0);
          const nh = img.naturalHeight || (thumb ? thumb.naturalHeight : 0);
          if (nw && nh) {
            sizeToViewport(nw, nh);
          } else {
            stage.style.width = "";
            stage.style.height = "";
          }
        };
        img.addEventListener("load", applyFit);

        function openLightbox(srcBtn: HTMLElement) {
          lastSource = srcBtn;
          const thumb = srcBtn.querySelector("img");
          const url = thumb ? thumb.currentSrc || thumb.src : "";
          const reveal = () => {
            reset();
            img.src = url;
            // Size from the thumbnail's natural ratio so the View Transition
            // captures the full size and the tile morphs *up* into it.
            applyFit();
            overlay.hidden = false;
            document.documentElement.classList.add("lightbox-open");
          };
          if (startVT) {
            // morph the rounded tile box ↔ the rounded stage box (both clip
            // their own content), so corners stay clean through the whole morph.
            srcBtn.style.viewTransitionName = VT_NAME;
            const t = startVT(() => {
              srcBtn.style.viewTransitionName = "";
              stage.style.viewTransitionName = VT_NAME;
              reveal();
            });
            t.finished.finally(() => {
              stage.style.viewTransitionName = "";
            });
          } else {
            reveal();
          }
        }

        function closeLightbox() {
          if (overlay.hidden) return;
          reset(); // morph back from the fitted image, not a zoomed crop
          const finish = () => {
            overlay.hidden = true;
            img.removeAttribute("src");
            document.documentElement.classList.remove("lightbox-open");
          };
          const src = lastSource;
          if (startVT && src) {
            stage.style.viewTransitionName = VT_NAME;
            const t = startVT(() => {
              stage.style.viewTransitionName = "";
              src.style.viewTransitionName = VT_NAME;
              finish();
            });
            t.finished.finally(() => {
              src.style.viewTransitionName = "";
            });
          } else {
            finish();
          }
        }

        // Each showcase tile (a <button>) opens its image. Using a real button
        // gives Enter/Space + focus for free.
        for (const btn of Array.from(document.querySelectorAll("[data-zoomable]"))) {
          btn.addEventListener("click", () => openLightbox(btn as HTMLElement));
        }

        // Click the mask (not the image/close button) to dismiss.
        overlay.addEventListener("click", (e) => {
          if (e.target === overlay) closeLightbox();
        });
        lightboxClose?.addEventListener("click", closeLightbox);
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") closeLightbox();
        });
        window.addEventListener("resize", () => {
          if (overlay.hidden) return;
          reset();
          applyFit();
        });

        // --- zoom: scroll fine-tunes, anchored at the cursor ---
        img.addEventListener(
          "wheel",
          (e) => {
            e.preventDefault();
            zoomTo(scale * Math.exp(-e.deltaY * 0.0016), e.clientX, e.clientY, false);
          },
          { passive: false },
        );

        // --- zoom: a click toggles between fit and a fixed zoom at the click
        // point. Dragging was intentionally dropped — click in, click out. ---
        stage.addEventListener("click", (e) => {
          if (scale > MIN_SCALE + 0.001) {
            zoomTo(MIN_SCALE, e.clientX, e.clientY, true);
          } else {
            zoomTo(ZOOM_LEVEL, e.clientX, e.clientY, true);
          }
        });
      }
    </script>
  </body>
</html>
