      /* Spectrum tint unifies the disparate stock photos into the cover-palette
         identity (back covers read cooler, front warmer). */
      .cover::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: linear-gradient(
          155deg,
          hsl(var(--hue) 80% 58% / 0.5),
