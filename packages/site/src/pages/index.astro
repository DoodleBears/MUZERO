---
// NOTE: imports MUST stay at the very top of the frontmatter. Astro's compiler
// hoists imports by byte offset; with imports placed after code AND multi-byte
// chars (—, →, ⌘) in the comments below, that splice miscalculated and corrupted
// the output ("Unterminated string literal"). Keep all imports first.
import { PLATFORM_ICONS } from "../lib/platform-icons";
import { OS_LABEL } from "../lib/release";
import AudioLinesIcon from "../components/AudioLinesIcon.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import LangSwitch from "../components/LangSwitch.astro";
import "../styles/theme.css";

// MUZERO landing page (mu0.app).
// Plain Astro page — owns "/". Starlight owns /docs/*.
// Centered hero: the copy sits in the middle, with album covers SCATTERED all
// around it. On scroll the covers converge from every direction to the center
// (the copy stays visible during the gather), then resolve into the MUZERO logo.
// Below the hero, an image-first showcase of the README media.
//
// Cover tiles are real, commercially-licensed photos (Pexels License) written as
// webp by scripts/fetch-covers.mjs. Swap in your own covers by editing that
// script's ID list (or pointing `covers[].src` at your own webp).

// "Open MUZERO" → the local app dev server in dev, my.mu0.app in prod.
// Override with PUBLIC_APP_URL if your app dev port differs from 41730.
const APP_URL =
  import.meta.env.PUBLIC_APP_URL ??
  (import.meta.env.DEV ? "http://localhost:41730" : "https://my.mu0.app");
const GITHUB_URL = "https://github.com/DoodleBears/MUZERO";

const DL_OSES = ["mac", "win", "linux"] as const;

// Deterministic pseudo-random so the scatter is stable across builds.
const rand = (s) => {
  const x = Math.sin(s * 12.9898) * 43758.5453;
  return x - Math.floor(x);
};

const COVER_COUNT = 18;
const covers = Array.from({ length: COVER_COUNT }, (_, i) => {
  const angle = (i / COVER_COUNT) * Math.PI * 2 + (rand(i) - 0.5) * 0.5; // even ring + slight jitter
  const radius = 0.7 + rand(i + 3) * 0.26; // 0.7..0.96 → a ring around center, not clustered
  const sx = +(Math.cos(angle) * radius * 34).toFixed(2); // vw offset (pulled in from edges)
  const sy = +(Math.sin(angle) * radius * 30 + 8).toFixed(2); // vh: range + downward bias so
  // the top of the ring clears the fixed header (no nav overlap) yet stays full
  const rot = +((rand(i + 9) * 2 - 1) * 26).toFixed(2); // -26..26 deg
  const scl = +(0.5 + rand(i + 3) * 0.6).toFixed(2); // 0.5..1.1
  const op = +(0.42 + scl * 0.4).toFixed(2); // depth-tied opacity
  const z = Math.round(scl * 100);
  const hue = Math.round((i / (COVER_COUNT - 1)) * 320);
  return { i, sx, sy, rot, scl, op, z, hue, src: `/covers/photo-${String(i + 1).padStart(2, "0")}.webp` };
});

const showcases = [
  {
    media: "/media/now-playing.webp",
    label: "Now Playing",
    title: "Immersive Now Playing",
    body: "Cover-driven palette, flow background, and a live spectrum.",
  },
  {
    media: "/media/visualizer.webp",
    label: "Visualize",
    title: "Visualizers & lyrics",
    body: "Cycle spectrum styles, then flip into word-by-word lyrics.",
  },
  {
    media: "/media/switch-song.webp",
    label: "Coverflow",
    title: "Swipe to switch",
    body: "A 3D coverflow you flick through by touch.",
  },
  {
    media: "/media/search.webp",
    label: "Search",
    title: "Find anything, fast",
    body: "⌘F across tracks, tags, lyrics, notes, and online sources.",
  },
  {
    media: "/media/library.webp",
    label: "Library",
    title: "Your whole library",
    body: "Sets, albums, artists, and smart playlists in one place.",
  },
  {
    media: "/media/dj.webp",
    label: "Agent DJ",
    title: "An AI DJ on the side",
    body: "Connect an LLM to curate sets and take requests, like a DJ.",
  },
  {
    media: "/media/settings.webp",
    label: "Personalize",
    title: "Make it yours",
    body: "Flow backgrounds, palettes, effects, lyrics, and themes.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090b" />
    <script is:inline>
      (() => {
        try {
          const p = localStorage.getItem("starlight-theme") || "auto";
          const t =
            p === "light" || p === "dark"
              ? p
              : matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.dataset.theme = t;
          const l = localStorage.getItem("muzero-site-lang");
          if (l) document.documentElement.dataset.lang = l;
        } catch {}
      })();
    </script>
    <link rel="icon" type="image/png" href="/muzero-logo-dark.png" />
    <!-- Inter (Google Fonts) — used only for the MUZERO wordmark/logo. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@800&display=swap"
      rel="stylesheet"
    />
    <title>MUZERO — Your private music museum</title>
    <meta
      name="description"
      content="MUZERO is your private, local-first music museum: upload, annotate, and play MV and music from every source — with an AI DJ on the side. No account, no cloud."
    />
    <link rel="canonical" href="https://mu0.app/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="MUZERO — Your private music museum" />
    <meta
      property="og:description"
      content="Upload, annotate, and play MV and music from every source — with an AI DJ on the side. Local-first: no account, no cloud."
    />
    <meta property="og:url" content="https://mu0.app/" />
    <meta property="og:image" content="https://mu0.app/muzero-logo-dark.png" />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <header class="site-header" id="siteHeader">
      <div class="header-pill">
        <a class="brand" href="/">
          <img class="brand-mark brand-mark--dark" src="/muzero-logo-dark.png" alt="" width="22" height="22" />
          <img class="brand-mark brand-mark--light" src="/muzero-logo-light.png" alt="" width="22" height="22" />
          <span class="wordmark">MUZERO</span>
        </a>
        <nav class="nav">
          <div class="nav-inline">
            <a href="/docs/">Docs</a>
            <a href="#download">Download</a>
            <a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
            <LangSwitch />
            <ThemeToggle />
          </div>
          <details class="nav-burger">
            <summary class="burger-btn" aria-label="Menu">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M3 6h18M3 12h18M3 18h18"></path>
              </svg>
            </summary>
            <div class="burger-menu">
              <a href="/docs/">Docs</a>
              <a href="#download">Download</a>
              <a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
              <div class="burger-foot">
                <div class="burger-lang">
                  <button type="button" data-set-lang="en">EN</button>
                  <button type="button" data-set-lang="zh">中</button>
                  <button type="button" data-set-lang="ja">あ</button>
                  <button type="button" data-set-lang="ko">한</button>
                </div>
                <ThemeToggle />
              </div>
            </div>
          </details>
          <a class="nav-cta" href={APP_URL}><AudioLinesIcon size={17} />Open MUZERO</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-visual" aria-hidden="true">
          <div class="cover-field" id="field">
            {
              covers.map((c) => (
                <div
                  class="cover"
                  style={`--sx:${c.sx}vw; --sy:${c.sy}vh; --rot:${c.rot}deg; --scl:${c.scl}; --hue:${c.hue}; opacity:${c.op}; z-index:${c.z};`}
                >
                  <img src={c.src} alt="" loading="eager" decoding="async" />
                </div>
              ))
            }
          </div>
        </div>

        <div class="container hero-copy">
          <h1>Your private<br />music museum.</h1>
          <p class="lede fade-out">
            Upload, annotate, and remember every song. Play from every source.
            Let an AI DJ keep the queue moving. Everything stays on your device.
          </p>
          <div class="cta-row fade-out">
            <a class="btn btn-primary" href={APP_URL}><AudioLinesIcon size={18} />Open MUZERO</a>
            <a class="btn btn-ghost" href="#download">Download</a>
            <a class="btn btn-link" href="/docs/">Read the docs →</a>
          </div>
        </div>

        <div class="hero-finale" id="finale" aria-hidden="true">
          <div class="hero-logo">
            <img src="/muzero-logo-dark.png" alt="" />
            <span class="hero-logo-word">MUZERO</span>
          </div>
          <div class="cta-row">
            <a class="btn btn-primary" href={APP_URL}><AudioLinesIcon size={18} />Open MUZERO</a>
            <a class="btn btn-ghost" href="#download">Download</a>
          </div>
        </div>
      </section>

      <section class="showcase container">
        {
          showcases.map((s) => (
            <article class="show-row reveal">
              <button
                class="show-media"
                type="button"
                aria-label={`Enlarge: ${s.title}`}
                data-zoomable
              >
                <img src={s.media} alt={s.title} loading="lazy" decoding="async" />
              </button>
              <div class="show-text">
                <span class="show-label">{s.label}</span>
                <h2>{s.title}</h2>
                <p>{s.body}</p>
              </div>
            </article>
          ))
        }
      </section>

      <section class="container download reveal" id="download">
        <h2>Bring your music home.</h2>
        <p class="download-sub" id="dl-sub">
          Desktop apps for macOS, Windows, and Linux — or <a href={APP_URL}>open the web app →</a>
        </p>

        <div class="dl-tiles" id="dl-tiles">
          {
            DL_OSES.map((os) => (
              <div class="dl-tile" data-os={os}>
                <span class="dl-ico" set:html={PLATFORM_ICONS[os]} />
                <span class="dl-os">{OS_LABEL[os]}</span>
                <a class="dl-btn" data-dl-primary href="#" hidden>
                  Download
                </a>
                <span class="dl-variants" data-dl-variants />
                <span class="dl-unavail" data-dl-unavail hidden>
                  Coming soon
                </span>
              </div>
            ))
          }
        </div>

        <p class="dl-fallback" id="dl-fallback" hidden>
          Desktop builds are on the way. For now, <a href={APP_URL}>open the web app</a> or
          <a href={GITHUB_URL} target="_blank" rel="noreferrer">watch on GitHub</a>.
        </p>

        <a class="dl-all" id="dl-all" href="/download/" hidden>All versions &amp; checksums →</a>
      </section>
    </main>

    <!-- Fullscreen image lightbox: opened from the showcase tiles via a native
         View Transition (the tile morphs into the fitted image). Mask click /
         Esc / close button dismiss; click toggles zoom, scroll fine-tunes it.
         The .lightbox-stage carries the rounded frame (NOT transformed) so the
         corners don't shimmer while the inner <img> scales. -->
    <div class="lightbox" id="lightbox" hidden>
      <button class="lightbox-close" id="lightboxClose" type="button" aria-label="Close">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            d="M6 6l12 12M18 6L6 18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </button>
      <div class="lightbox-stage" id="lightboxStage">
        <img class="lightbox-img" id="lightboxImg" alt="" draggable="false" />
      </div>
      <p class="lightbox-hint" aria-hidden="true">
        <span class="lc" data-lc="en">Click to zoom · scroll to fine-tune · Esc or click outside to close</span>
        <span class="lc" data-lc="zh">点击放大 · 滚动微调 · Esc 或点击外部关闭</span>
        <span class="lc" data-lc="ja">クリックで拡大 · スクロールで微調整 · Esc または外側クリックで閉じる</span>
        <span class="lc" data-lc="ko">클릭하여 확대 · 스크롤로 미세 조정 · Esc 또는 바깥 클릭으로 닫기</span>
      </p>
    </div>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span class="wordmark small">MUZERO</span>
        <nav class="footer-nav">
          <a href="/docs/">Docs</a>
          <a href="#download">Download</a>
          <a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
        </nav>
        <span class="muted">Local-first. Your music stays on your device.</span>
      </div>
    </footer>

    <style>
      @property --gather {
        syntax: "<number>";
        inherits: true;
        initial-value: 0;
      }

      /* Colors + --font live in src/styles/theme.css (dark + light). */
      :root {
        --container: 1080px;
      }

      * {
        box-sizing: border-box;
      }

      :global(html) {
        background: var(--bg);
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: 100%;
        max-width: var(--container);
        margin-inline: auto;
        padding-inline: 24px;
      }

      /* ---------- floating island header (anysoul-style pill) ---------- */
      .site-header {
        position: fixed;
        left: 50%;
        top: 14px;
        transform: translateX(-50%);
        z-index: 50;
        width: 100%;
        max-width: 1120px;
        padding-inline: 16px;
        transition: max-width 0.55s cubic-bezier(0.4, 0, 0.2, 1);
      }
      /* Elastic: shrink the island once the page is scrolled. */
      .site-header.scrolled {
        max-width: 860px;
      }
      .header-pill {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        border-radius: 999px;
        padding: 8px 10px 8px 18px;
        /* Inverted solid pill: background = page foreground, content = page bg. */
        background: var(--header-bg);
        color: var(--header-fg);
        box-shadow: 0 12px 34px -18px rgba(0, 0, 0, 0.55);
        transition: box-shadow 0.3s ease;
      }
      /* Solid inverted pill; deepen the shadow a touch once scrolled. */
      .site-header.scrolled .header-pill {
        box-shadow: 0 16px 42px -16px rgba(0, 0, 0, 0.6);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 9px;
        flex: none;
      }
      .brand-mark {
        width: 22px;
        height: 22px;
        display: block;
      }
      /* Pill is inverted, so the logo matches the PILL background:
         dark theme = light pill → dark logo; light theme = dark pill → light logo. */
      .brand-mark--light {
        display: none;
      }
      :global(html[data-theme="light"]) .brand-mark--dark {
        display: none;
      }
      :global(html[data-theme="light"]) .brand-mark--light {
        display: block;
      }
      .wordmark {
        /* Unified MUZERO wordmark/logo type: Inter ExtraBold, -8% tracking. */
        font-family: "Inter", var(--font);
        font-weight: 800;
        letter-spacing: -0.08em;
        font-size: 1.2rem;
      }
      .wordmark.small {
        font-size: 0.95rem;
        color: var(--muted);
      }
      .nav {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .nav-inline {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 0.92rem;
        color: var(--header-muted);
      }
      .nav-inline a:hover {
        color: var(--header-fg);
      }
      .nav-cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        /* Cutout button on the inverted pill: bg = page fg, text = page bg. */
        color: var(--header-bg) !important;
        background: var(--header-fg);
        padding: 9px 18px;
        border-radius: 999px;
        font-weight: 600;
        transition:
          background 0.15s ease,
          transform 0.15s ease;
      }
      .nav-cta:hover {
        opacity: 0.9;
        transform: translateY(-1px);
      }
      /* Inline (desktop) toggle + lang adopt the inverted header palette. The
         burger-menu copies use normal page colors (page-bg dropdown). */
      .nav-inline :global(.theme-toggle),
      .nav-inline :global(.lang-switch summary) {
        color: var(--header-muted);
        border-color: var(--header-line);
      }
      .nav-inline :global(.theme-toggle:hover),
      .nav-inline :global(.lang-switch summary:hover),
      .nav-inline :global(.lang-switch[open] summary) {
        color: var(--header-fg);
        border-color: var(--header-fg);
        background: color-mix(in srgb, var(--header-fg) 12%, transparent);
      }

      /* ---- mobile hamburger ---- */
      .nav-burger {
        position: relative;
        display: none;
      }
      .burger-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 999px;
        border: 1px solid var(--header-line);
        color: var(--header-muted);
        cursor: pointer;
        list-style: none;
      }
      .burger-btn::-webkit-details-marker {
        display: none;
      }
      .nav-burger[open] .burger-btn,
      .burger-btn:hover {
        color: var(--header-fg);
        border-color: var(--header-fg);
        background: color-mix(in srgb, var(--header-fg) 12%, transparent);
      }
      .burger-menu {
        position: absolute;
        right: 0;
        top: calc(100% + 10px);
        min-width: 210px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 8px;
        border-radius: 16px;
        border: 1px solid var(--line);
        background: color-mix(in srgb, var(--bg) 92%, transparent);
        backdrop-filter: blur(14px);
        box-shadow: 0 26px 60px -28px rgba(0, 0, 0, 0.6);
        z-index: 40;
      }
      .burger-menu > a {
        padding: 10px 12px;
        border-radius: 10px;
        color: var(--fg);
        font-size: 0.95rem;
      }
      .burger-menu > a:hover {
        background: var(--accent-soft);
      }
      .burger-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 6px;
        padding-top: 10px;
        border-top: 1px solid var(--line);
      }
      .burger-lang {
        display: flex;
        gap: 4px;
      }
      .burger-lang button {
        min-width: 34px;
        height: 32px;
        padding-inline: 6px;
        border-radius: 8px;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--muted);
        font: inherit;
        font-size: 0.82rem;
        cursor: pointer;
      }
      .burger-lang button:hover {
        color: var(--fg);
        border-color: var(--accent);
        background: var(--accent-soft);
      }

      /* ---------- hero (centered copy + scattered covers) ---------- */
      .hero {
        position: relative;
        min-height: 94vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
      }
      .hero-copy {
        position: relative;
        z-index: 2;
        max-width: 680px;
      }
      /* Vignette behind the centered copy keeps it legible over the covers. */
      .hero-copy::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 150%;
        height: 220%;
        transform: translate(-50%, -50%);
        background: radial-gradient(
          50% 50% at 50% 50%,
          color-mix(in srgb, var(--bg) 92%, transparent),
          color-mix(in srgb, var(--bg) 60%, transparent) 45%,
          transparent 72%
        );
        z-index: -1;
        pointer-events: none;
      }
      .eyebrow {
        margin: 0 0 28px;
        font-size: 0.8rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--faint);
      }
      h1 {
        margin: 0;
        font-size: clamp(2.8rem, 7vw, 5rem);
        line-height: 1.03;
        font-weight: 600;
        letter-spacing: -0.02em;
      }
      .lede {
        margin: 28px auto 0;
        max-width: 48ch;
        font-size: clamp(1.05rem, 2.2vw, 1.22rem);
        color: var(--muted);
      }
      .cta-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 14px;
        margin-top: 40px;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        height: 46px;
        padding-inline: 24px;
        border-radius: 999px;
        font-size: 0.96rem;
        font-weight: 500;
        border: 1px solid transparent;
        transition:
          background 0.15s ease,
          border-color 0.15s ease,
          transform 0.15s ease;
      }
      .btn:hover {
        transform: translateY(-1px);
      }
      .btn-primary {
        background: var(--fg);
        color: var(--bg);
      }
      .btn-primary:hover {
        opacity: 0.9;
      }
      .btn-ghost {
        border-color: var(--line);
        color: var(--fg);
      }
      .btn-ghost:hover {
        border-color: var(--accent);
        background: var(--accent-soft);
      }
      .btn-link {
        color: var(--muted);
        padding-inline: 8px;
      }
      .btn-link:hover {
        color: var(--fg);
      }

      /* ---------- scattered cover field ---------- */
      .hero-visual {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
      }
      .cover-field {
        position: absolute;
        inset: 0;
        will-change: transform;
      }
      .cover {
        position: absolute;
        left: 50%;
        top: 50%;
        width: clamp(88px, 10vw, 152px);
        aspect-ratio: 1 / 1;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid var(--cover-line);
        box-shadow: 0 26px 60px -30px rgba(0, 0, 0, 0.8);
        /* --gather 0 = scattered, 1 = converged at center. */
        /* --gather 0 = scattered ring, 1 = converged at a point below the title
           (matches the .hero-finale position so covers gather INTO the logo). */
        transform: translate(-50%, -50%)
          translate(
            calc(var(--sx) * (1 - var(--gather))),
            calc(var(--sy) * (1 - var(--gather)) + 15vh * var(--gather))
          )
          rotate(calc(var(--rot) * (1 - var(--gather))))
          scale(calc(var(--scl) + (0.34 - var(--scl)) * var(--gather)));
      }
      .cover img {
