---
// Per-locale landing: /zh/, /ja/, /ko/. en lives at src/pages/index.astro.
import Landing from "../../components/Landing.astro";
import type { Locale } from "../../i18n";

export function getStaticPaths() {
  return [{ params: { lang: "zh" } }, { params: { lang: "ja" } }, { params: { lang: "ko" } }];
}

const { lang } = Astro.params;
---

<Landing locale={lang as Locale} />
