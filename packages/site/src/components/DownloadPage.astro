---
// Imports first — Astro hoists imports by byte offset; placing them after code
// with multi-byte chars in comments corrupts the output. Keep imports at top.
import { changelog, localize } from "../lib/changelog";
import LangSwitch from "../components/LangSwitch.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { alternates, localizedPath, LOCALE_HTML_LANG, useTranslations, type Locale } from "../i18n";
import "../styles/theme.css";

// MUZERO downloads + changelog archive (mu0.app/download).
// The primary "get the latest" download lives on the landing (/#download); this
// page is the full release history: the app's changelog (multilingual, same
// source as Settings → Version history) with per-platform download buttons.
// Changelog text is server-rendered for every locale (.lc spans, toggled by CSS
// via <html data-lang>); download buttons are injected client-side from the
// release manifest (assets.mu0.app/desktop/manifest.json). It's also where the
// Electron updater sends users for manual updates.
const APP_URL =
  import.meta.env.PUBLIC_APP_URL ??
  (import.meta.env.DEV ? "http://localhost:41730" : "https://my.mu0.app");
const GITHUB_URL = "https://github.com/DoodleBears/MUZERO";

// Rendered as a component by src/pages/download.astro (en) and
// src/pages/[lang]/download.astro (zh/ja/ko) — locale comes in as a prop.
const locale = (Astro.props.locale ?? "en") as Locale;
const t = useTranslations(locale);
const hreflangs = alternates(Astro.url.pathname);
const hasText = (field) => !!localize(field, locale);
---

<!doctype html>
<html lang={LOCALE_HTML_LANG[locale]} data-lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090b" />
    <script is:inline>
      (() => {
        try {
          const p = localStorage.getItem("starlight-theme") || "auto";
          const t =
            p === "light" || p === "dark"
              ? p
              : matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.dataset.theme = t;
        } catch {}
      })();
    </script>
    <link rel="icon" type="image/png" href="/muzero-logo-dark.png" />
    <!-- Inter (Google Fonts) — MUZERO wordmark/logo. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@800&display=swap"
      rel="stylesheet"
    />
    <title>{t.download.title} · MUZERO</title>
    <meta name="description" content={t.download.sub} />
    <link rel="canonical" href={`https://mu0.app${localizedPath("/download/", locale)}`} />
    {
      hreflangs.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={`https://mu0.app${a.href}`} />
      ))
    }
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href={localizedPath("/", locale)}>MUZERO</a>
        <nav class="nav">
          <a class="nav-link" href={`${localizedPath("/", locale)}#download`}>{t.nav.download}</a>
          <a class="nav-link" href={localizedPath("/docs/", locale)}>{t.nav.docs}</a>
          <a class="nav-link" href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
          <LangSwitch />
          <ThemeToggle />
          <a class="nav-cta" href={APP_URL}>{t.nav.openApp}</a>
        </nav>
      </div>
    </header>

    <main class="container versions">
      <h1>{t.download.title}</h1>
      <p class="sub">{t.download.sub}</p>

      {
        changelog.map((r) => (
          <article class="v-row" data-version={r.version}>
            <div class="v-head">
              <span class="v-ver">v{r.version}</span>
              <span class="v-date">{r.date}</span>
            </div>
            {hasText(r.title) && <h2 class="v-title">{localize(r.title, locale)}</h2>}
            {hasText(r.summary) && <p class="v-summary">{localize(r.summary, locale)}</p>}
            <div class="v-downloads" data-version={r.version} />
          </article>
        ))
      }
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span class="wordmark small">MUZERO</span>
        <span class="muted">{t.footer.tagline}</span>
      </div>
    </footer>

    <!-- Global (not scoped): the download buttons are injected at runtime via
         innerHTML, and Astro's scoped styles only match build-time elements.
         A standalone page can safely style globally. -->
    <style is:global>
      * {
        box-sizing: border-box;
      }
      html {
        background: var(--bg);
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      .container {
        width: 100%;
        max-width: 760px;
        margin-inline: auto;
        padding-inline: 24px;
      }

      /* header */
      .site-header {
        border-bottom: 1px solid var(--line);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        height: 64px;
        width: 100%;
        max-width: 1080px;
        margin-inline: auto;
        padding-inline: 24px;
      }
      .wordmark {
        /* Unified MUZERO wordmark/logo type: Inter ExtraBold, -8% tracking. */
        font-family: "Inter", var(--font);
        font-weight: 800;
        letter-spacing: -0.08em;
        font-size: 1.1rem;
      }
      .wordmark.small {
        font-size: 0.9rem;
        color: var(--muted);
      }
      .nav {
        display: flex;
        align-items: center;
        gap: 18px;
        font-size: 0.92rem;
        color: var(--muted);
      }
      .nav-link:hover {
        color: var(--fg);
      }
      .nav-cta {
        color: var(--fg);
        border: 1px solid var(--line);
        padding: 7px 16px;
        border-radius: 999px;
      }
      .nav-cta:hover {
        border-color: var(--accent);
        background: var(--accent-soft);
      }

      /* page */
      .versions {
        padding-block: 72px 120px;
      }
      h1 {
        margin: 0;
        font-size: clamp(2.2rem, 6vw, 3rem);
        font-weight: 600;
        letter-spacing: -0.02em;
      }
      .sub {
        margin: 18px 0 48px;
        max-width: 60ch;
        color: var(--muted);
      }

      /* version rows */
      .v-row {
        padding-block: 32px;
        border-top: 1px solid var(--line);
      }
      .v-head {
        display: flex;
        align-items: baseline;
        gap: 12px;
      }
      .v-ver {
        font-weight: 600;
        font-size: 1.15rem;
      }
      .v-date {
        color: var(--faint);
        font-size: 0.88rem;
        font-variant-numeric: tabular-nums;
      }
      .v-title {
        margin: 14px 0 0;
        font-size: 1.12rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .v-summary {
        margin: 10px 0 0;
        color: var(--muted);
        max-width: 68ch;
      }
      .v-downloads {
        margin-top: 18px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }
      .v-downloads:empty {
        margin-top: 0;
      }
      .v-asset {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border: 1px solid var(--line);
        border-radius: 10px;
        font-size: 0.86rem;
        color: var(--muted);
        transition:
          border-color 0.15s ease,
          color 0.15s ease,
          background 0.15s ease;
      }
      .v-asset:hover {
        color: var(--fg);
        border-color: var(--accent);
        background: var(--accent-soft);
      }
      /* the variant matching the visitor's OS reads as primary */
      .v-asset--match {
        color: var(--fg);
        border-color: color-mix(in srgb, var(--accent) 60%, var(--line));
      }

      /* footer */
      .site-footer {
        border-top: 1px solid var(--line);
      }
      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 24px;
        padding-block: 28px;
        font-size: 0.86rem;
        width: 100%;
        max-width: 1080px;
        margin-inline: auto;
        padding-inline: 24px;
      }
      .footer-inner .muted {
        margin-left: auto;
        color: var(--faint);
      }
    </style>

    <script>
      import {
        fetchManifest,
        currentOsFamily,
        osOfPlatform,
        OS_LABEL,
        VARIANT_LABEL,
        PLATFORMS,
        formatBytes,
      } from "../lib/release";

      const os = currentOsFamily();
      const esc = (s: string) =>
        s.replace(
          /[&<>"]/g,
          (c) =>
            (({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }) as Record<string, string>)[
              c
            ],
        );

      async function initDownloads() {
        let manifest: Awaited<ReturnType<typeof fetchManifest>> | null = null;
        try {
          manifest = await fetchManifest();
        } catch {
          return; // no manifest yet → changelog still renders, no buttons
        }
        for (const r of manifest.releases) {
          const box = document.querySelector<HTMLElement>(
            `.v-downloads[data-version="${CSS.escape(r.version)}"]`,
          );
          if (!box) continue;
          box.innerHTML = PLATFORMS.filter((p) => r.platforms[p])
            .map((p) => {
              const a = r.platforms[p]!;
              const match = osOfPlatform(p) === os ? " v-asset--match" : "";
              const size = formatBytes(a.size);
              const label = `${OS_LABEL[osOfPlatform(p)]} · ${VARIANT_LABEL[p]}${size ? ` · ${size}` : ""}`;
              return `<a class="v-asset${match}" href="${esc(a.url)}" title="sha256: ${esc(a.sha256)}">${esc(label)}</a>`;
            })
            .join("");
        }
      }

      void initDownloads();
    </script>
  </body>
</html>
