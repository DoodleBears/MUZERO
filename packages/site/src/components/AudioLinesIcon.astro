---
// Animated "audio lines" icon — a CSS-only replica of the main app's
// AudioLinesIcon (src/components/ui/audio-lines.tsx, the lucide `audio-lines`
// glyph). The 4 inner bars bounce like an equalizer at different speeds; the 2
// outer bars stay static. Used on the "Open MUZERO" CTA so it reads as "live".
interface Props {
  size?: number;
  class?: string;
}
const { size = 18, class: className = "" } = Astro.props;
---

<svg
  class:list={["audio-lines", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <line x1="2" y1="10" x2="2" y2="13" />
  <line class="b b1" x1="6" y1="6" x2="6" y2="17" />
  <line class="b b2" x1="10" y1="3" x2="10" y2="21" />
  <line class="b b3" x1="14" y1="8" x2="14" y2="15" />
  <line class="b b4" x1="18" y1="5" x2="18" y2="18" />
  <line x1="22" y1="10" x2="22" y2="13" />
</svg>

<style>
  .audio-lines {
    display: block;
    flex: none;
  }
  .audio-lines .b {
    transform-box: fill-box;
    transform-origin: center;
    animation: al-bar 1.2s ease-in-out infinite;
  }
  .audio-lines .b1 {
    animation-duration: 1.5s;
  }
  .audio-lines .b2 {
    animation-duration: 1s;
  }
  .audio-lines .b3 {
    animation-duration: 0.8s;
  }
  .audio-lines .b4 {
    animation-duration: 1.5s;
    animation-delay: 0.15s;
  }
  @keyframes al-bar {
    0%,
    100% {
      transform: scaleY(1);
    }
    50% {
      transform: scaleY(0.3);
    }
  }
</style>
