---
// Changelog language switcher (globe dropdown). Sets <html data-lang="en|zh|ja|ko">
// and persists to localStorage["muzero-site-lang"]; the page CSS then shows only
// the matching .lc[data-lc] spans. A pre-paint inline script in each page <head>
// applies the saved lang to avoid a flash. Uses a native <details> so the menu
// open/close needs no JS.
---

<details class="lang-switch">
  <summary aria-label="Change language">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M2 12h20"></path>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"></path>
    </svg>
    <span class="ls-label" data-ls-label>EN</span>
  </summary>
  <div class="ls-menu">
    <button type="button" data-set-lang="en">English</button>
    <button type="button" data-set-lang="zh">简体中文</button>
    <button type="button" data-set-lang="ja">日本語</button>
    <button type="button" data-set-lang="ko">한국어</button>
  </div>
</details>

<style>
  .lang-switch {
    position: relative;
    flex: none;
  }
  .lang-switch summary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding-inline: 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--muted);
    cursor: pointer;
    list-style: none;
    font-size: 0.85rem;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .lang-switch summary::-webkit-details-marker {
    display: none;
  }
  .lang-switch summary:hover,
  .lang-switch[open] summary {
    color: var(--fg);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .ls-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 160px;
    display: flex;
    flex-direction: column;
    padding: 6px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.6);
    z-index: 40;
  }
  .ls-menu button {
    text-align: left;
    padding: 9px 12px;
    border-radius: 9px;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .ls-menu button:hover {
    color: var(--fg);
    background: var(--accent-soft);
  }
</style>

<script>
  // Route-based switch: navigate to the same page in another locale (/, /zh/,
  // /ja/, /ko/). The destination renders that locale server-side. Inlined path
  // logic (mirrors src/i18n) so the client bundle doesn't pull the catalog.
  const SHORT: Record<string, string> = { en: "EN", zh: "中", ja: "あ", ko: "한" };
  const LOCALES = ["en", "zh", "ja", "ko"];
  const DEFAULT = "en";

  function localizedPath(pathname: string, locale: string): string {
    const segs = pathname.replace(/^\/+/, "").split("/");
    const hasLocale = !!segs[0] && LOCALES.includes(segs[0]) && segs[0] !== DEFAULT;
    const base = hasLocale
      ? `/${segs.slice(1).join("/")}`
      : pathname.startsWith("/")
        ? pathname
        : `/${pathname}`;
    if (locale === DEFAULT) return base;
    if (base === "/") return `/${locale}/`;
    return `/${locale}${base}`;
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-set-lang]")) {
    btn.addEventListener("click", () => {
      const lang = btn.dataset.setLang ?? "en";
      try {
        localStorage.setItem("muzero-site-lang", lang);
      } catch {}
      const target = localizedPath(window.location.pathname, lang) + window.location.hash;
      if (target !== window.location.pathname + window.location.hash) {
        window.location.href = target;
      }
      btn.closest("details")?.removeAttribute("open");
    });
  }

  // Label reflects the locale rendered server-side (<html data-lang>).
  const cur = document.documentElement.dataset.lang || "en";
  for (const el of document.querySelectorAll("[data-ls-label]")) {
    el.textContent = SHORT[cur] ?? "EN";
  }
</script>
