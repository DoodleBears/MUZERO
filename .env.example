# MUZERO is local-first and BYOK (bring your own keys). API keys for the LLM DJ
# and the cloud music-generation provider are entered in the in-app Settings
# screen and stored in IndexedDB on-device — NOT here, and never in the bundle.
#
# The only optional build-time vars are non-secret defaults used to pre-fill the
# Settings form on first run (handy for local dev). Leave them blank in commits.

# Default LLM provider id for the DJ ("openai" | "anthropic"). User overrides in Settings.
VITE_DEFAULT_LLM_PROVIDER=openai
