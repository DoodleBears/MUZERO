{
  "name": "muzero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MUZERO — local-first AI DJ music player. An LLM writes prompts, calls a music-generation API, and endlessly extends your playlist. Tauri desktop + mobile, no backend, no cloud.",
  "scripts": {
    "prepare": "lefthook install || true",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "electron:dev": "electron electron/main.cjs",
    "electron:preview": "electron electron/main.cjs",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "ui:coss": "pnpm dlx shadcn@latest add @coss/ui",
    "ui:visualizer": "pnpm dlx shadcn@latest add @livekit/agent-audio-visualizer-aura"
  },
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/openai": "^3.0.65",
    "@ai-sdk/react": "^3.0.199",
    "@base-ui/react": "^1.5.0",
    "@chenglou/pretext": "^0.0.7",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-virtual": "^3.13.25",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "ai": "^6.0.197",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "i18next": "^26.3.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "music-metadata": "^11.13.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.19.0",
    "react": "^19.2.6",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.2.6",
    "react-easy-crop": "^5.5.7",
    "react-i18next": "^17.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "twgl.js": "^7.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.20",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.3",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.9",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
