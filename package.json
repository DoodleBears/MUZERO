{
  "name": "muzero",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "MUZERO — your private, local-first music museum. Sync & play MV and music across every device, with friends. No account, no cloud; everything lives on your device. Electron desktop + Tauri mobile.",
  "license": "Apache-2.0",
  "scripts": {
    "prepare": "lefthook install || true",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pages:project:create": "wrangler pages project create mu0-app --production-branch=main --compatibility-date=2026-06-12",
    "pages:deploy": "pnpm build && wrangler pages deploy dist --project-name=mu0-app --branch=main",
    "pages:deploy:preview": "pnpm build && wrangler pages deploy dist --project-name=mu0-app --branch=preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "react-doctor": "react-doctor --no-telemetry",
    "react-doctor:perf": "react-doctor --no-telemetry --category Performance --category Bugs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:preview": "electron electron/main.cjs",
    "electron:profile": "node scripts/electron-profile.mjs",
    "electron:bundle": "node scripts/build-electron-main.mjs",
    "electron:build": "vite build && node scripts/build-electron-main.mjs && electron-builder",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "ui:coss": "pnpm dlx shadcn@latest add @coss/ui",
    "ui:visualizer": "pnpm dlx shadcn@latest add @livekit/agent-audio-visualizer-aura"
  },
  "electronmon": {
    "patterns": [
      "!src",
      "!src/**/*",
      "!dist",
      "!dist/**/*",
      "!dist-electron",
      "!dist-electron/**/*",
      "!release",
      "!release/**/*",
      "!docs",
      "!docs/**/*",
      "!scripts",
      "!scripts/**/*",
      "!src-tauri",
      "!src-tauri/**/*",
      "!.logs",
      "!.logs/**/*",
      "!*.md",
      "!*.log"
    ]
  },
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=10.18.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.83",
    "@ai-sdk/openai": "^3.0.70",
    "@ai-sdk/react": "^3.0.204",
    "@base-ui/react": "^1.5.0",
    "@chenglou/pretext": "^0.0.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@noble/ciphers": "^2.2.0",
    "@sglkc/kuromoji": "^1.1.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "ai": "^6.0.202",
    "bgutils-js": "3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "i18next": "^26.3.1",
    "lenis": "^1.3.23",
    "lucide-react": "^1.18.0",
    "mediabunny": "1.45.4",
    "motion": "^12.40.0",
    "music-metadata": "^11.13.0",
    "pinyin-pro": "^3.28.1",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.19.0",
    "react": "^19.2.7",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.2.7",
    "react-easy-crop": "^5.5.7",
    "react-i18next": "^17.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "thumbhash": "^0.1.1",
    "twgl.js": "^7.0.0",
    "wanakana": "^5.3.1",
    "youtubei.js": "^17.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "app.mu0.muzero",
    "productName": "MUZERO",
    "executableName": "muzero",
    "copyright": "© Doodlekuma",
    "asar": false,
    "compression": "maximum",
    "generateUpdatesFilesForAllChannels": true,
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules",
      "!node_modules/**"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "generic",
      "url": "https://assets.mu0.app/desktop",
      "channel": "latest"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "src-tauri/icons/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src-tauri/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "MUZERO <noreply@mu0.app>",
      "category": "Audio",
      "icon": "src-tauri/icons/icon.png"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electronmon": "^2.0.4",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "lefthook": "^2.1.9",
    "react-doctor": "^0.5.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.100.0"
  }
}
