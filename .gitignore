# dependencies
node_modules/

# build output
dist/
dist-ssr/
*.local

# Electron build artifacts (bundled main + packaged installers)
dist-electron/
release/

# Tauri build artifacts (Rust target + generated mobile projects)
src-tauri/target/
src-tauri/gen/

# environment variables (BYOK keys live in IndexedDB, never committed)
.env
.env.local
.env.production

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# test / coverage artifacts
coverage/
.vitest-attachments/

# TypeScript incremental build cache
*.tsbuildinfo

# local-only scheduled-task lock written by Claude Code skills
.claude/scheduled_tasks.lock
.claude/worktrees/

# Wrangler local cache (R2 admin commands)
.wrangler/
.VSCodeCounter
.logs
.worktrees/
reference-repo
.electron-dist/
