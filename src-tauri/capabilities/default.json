{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the MUZERO main window: HTTP to local + BYOK APIs, OS info, dialogs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "os:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "https://api.openai.com/*" },
        { "url": "https://api.anthropic.com/*" }
      ]
    }
  ]
}
