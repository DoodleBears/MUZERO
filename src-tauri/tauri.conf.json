{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MUZERO",
  "version": "1.2.2",
  "identifier": "app.mu0.muzero",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:41730",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MUZERO",
        "width": 1180,
        "height": 780,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
